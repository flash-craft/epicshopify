{
  "sections": {
    "kynza_hero": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"kynza-hero\" aria-labelledby=\"kynza-hero-title\"><div class=\"kynza-hero__copy\"><p class=\"kynza-eyebrow\"><span class=\"kynza-sparkle\" aria-hidden=\"true\">✦</span> THE KYNZA EDIT / DISCOVER YOUR NEXT FAVORITE</p><h1 id=\"kynza-hero-title\">Better finds.<br><em>Better every day.</em></h1><p class=\"kynza-lede\">Discover feel-good essentials and standout finds, thoughtfully picked to make your everyday routine a little better.</p><div class=\"kynza-actions\"><a class=\"kynza-button kynza-button--dark\" href=\"{{ routes.all_products_collection_url }}\">Shop the collection <span aria-hidden=\"true\">↗</span></a><a class=\"kynza-link\" href=\"#kynza-discover\">Explore best sellers ↓</a></div><p class=\"kynza-hero__note\">THOUGHTFUL FINDS <span aria-hidden=\"true\">✳</span> EVERYDAY FAVORITES <span aria-hidden=\"true\">✳</span> KYNZA</p></div><div class=\"kynza-hero__visual\">{% assign hero_product = collections.all.products.first %}{% if hero_product and hero_product.featured_image %}<a href=\"{{ hero_product.url }}\" class=\"kynza-hero__product\"><span class=\"kynza-hero__badge\">THE CURRENT CRUSH / 01</span><img src=\"{{ hero_product.featured_image | image_url: width: 1100 }}\" srcset=\"{{ hero_product.featured_image | image_url: width: 550 }} 550w, {{ hero_product.featured_image | image_url: width: 850 }} 850w, {{ hero_product.featured_image | image_url: width: 1100 }} 1100w\" sizes=\"(max-width: 900px) 90vw, 42vw\" alt=\"{{ hero_product.featured_image.alt | default: hero_product.title | escape }}\" width=\"1100\" height=\"1375\" fetchpriority=\"high\"><span class=\"kynza-hero__caption\">{{ hero_product.title | escape }} <span aria-hidden=\"true\">↗</span></span></a>{% else %}<div class=\"kynza-hero__placeholder\"><span>✳</span><strong>THE GOOD STUFF<br>STARTS HERE.</strong><small>YOUR NEXT FAVORITE IS WAITING</small></div>{% endif %}</div></section>",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "kynza_intro": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"kynza-intro\" id=\"kynza-discover\"><div><p class=\"kynza-eyebrow\">01 / THE KYNZA DIFFERENCE</p><h2>Find the good stuff.<br><em>Keep it close.</em></h2></div><div class=\"kynza-intro__copy\"><p>We believe the best products earn a place in your everyday. Explore a considered mix of useful essentials, feel-good upgrades, and discoveries worth sharing.</p><a class=\"kynza-link\" href=\"{{ routes.all_products_collection_url }}\">Shop customer favorites ↗</a></div></section>",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "kynza_categories": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"kynza-categories\"><div class=\"kynza-section-head\"><p class=\"kynza-eyebrow\">02 / SHOP THE KYNZA EDIT</p><h2>A better find<br><em>starts here.</em></h2><p class=\"kynza-section-subtitle\">Browse by collection and discover something worth coming back for.</p></div><div class=\"kynza-category-grid\"><a href=\"{{ routes.all_products_collection_url }}\"><span>01 / THE GLOW UP</span><strong>Shop the edit <b aria-hidden=\"true\">↗</b></strong><small>Explore the full collection.</small></a><a href=\"{{ routes.all_products_collection_url }}\"><span>02 / THE FINISHING TOUCH</span><strong>Everyday favorites <b aria-hidden=\"true\">↗</b></strong><small>Find something you'll use on repeat.</small></a><a href=\"{{ routes.all_products_collection_url }}\"><span>03 / THE RESET</span><strong>New discoveries <b aria-hidden=\"true\">↗</b></strong><small>Fresh finds, all in one place.</small></a><a href=\"{{ routes.all_products_collection_url }}?sort_by=best-selling\"><span>04 / THE GOOD LIST</span><strong>Best sellers <b aria-hidden=\"true\">↗</b></strong><small>Discover the crowd favorites.</small></a></div></section>",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "kynza_products": {
      "type": "product-list",
      "settings": {
        "collection": "all",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 8,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 20,
        "rows_gap": 42,
        "icons_style": "none",
        "icons_shape": "none",
        "section_width": "page-width",
        "horizontal_alignment": "flex-start",
        "gap": 32,
        "background_color": "",
        "padding-block-start": 0,
        "padding-block-end": 0
      },
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": true,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "gap": 12,
            "width": "fill",
            "height": "fit"
          },
          "blocks": {
            "title": {
              "type": "_product-list-text",
              "settings": {
                "text": "<p>03 / THE KYNZA EDIT</p><h2>Worth a closer<br><em>look.</em></h2>",
                "width": "fit-content",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "wrap": "pretty"
              }
            },
            "shop-all": {
              "type": "_product-list-button",
              "settings": {
                "label": "View all →",
                "open_in_new_tab": false,
                "style_class": "link",
                "width": "fit-content",
                "width_mobile": "fit-content"
              }
            }
          },
          "block_order": [
            "title",
            "shop-all"
          ]
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 8,
            "border": "none",
            "border_width": 0,
            "border_opacity": 0,
            "border_radius": 0
          },
          "blocks": {
            "gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "adapt",
                "border": "none",
                "border_width": 0,
                "border_opacity": 0,
                "border_radius": 0
              }
            },
            "title": {
              "type": "product-title",
              "settings": {
                "width": "100%",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "1.4",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "padding-block-start": 10
              }
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "paragraph",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "0.95rem",
                "line_height": "1.4",
                "letter_spacing": "normal",
                "case": "none"
              }
            }
          },
          "block_order": [
            "gallery",
            "title",
            "price"
          ]
        }
      }
    },
    "kynza_close": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"kynza-close\"><div><p class=\"kynza-eyebrow\">04 / KEEP DISCOVERING</p><h2>Consider this<br><em>your sign.</em></h2><p>New favorites are only a click away. Go on, find something that feels like you.</p></div><a class=\"kynza-button kynza-button--light\" href=\"{{ routes.all_products_collection_url }}\">Shop the full edit ↗</a></section>",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
  "order": [
    "kynza_hero",
    "kynza_intro",
    "kynza_categories",
    "kynza_products",
    "kynza_close"
  ]
}
