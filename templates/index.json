{
  "sections": {
    "kynza_hero": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"kynza-hero kynza-hero--beauty\" aria-labelledby=\"kynza-hero-title\"><div class=\"kynza-hero__copy\"><p class=\"kynza-eyebrow\"><span class=\"kynza-sparkle\" aria-hidden=\"true\">✦</span> THE KYNZA SKIN EDIT / GOOD SKIN DAYS START HERE</p><h1 id=\"kynza-hero-title\">Your skin.<br><em>Your kind of glow.</em></h1><p class=\"kynza-lede\">Little rituals. Feel-good formulas. A fresh take on everyday skincare — find the mask that fits your moment.</p><div class=\"kynza-actions\"><a class=\"kynza-button kynza-button--dark\" href=\"{{ routes.all_products_collection_url }}\">Shop skincare <span aria-hidden=\"true\">↗</span></a><a class=\"kynza-link\" href=\"#kynza-discover\">Find your ritual ↓</a></div><p class=\"kynza-hero__note\">SKINCARE, MADE FUN <span aria-hidden=\"true\">✳</span> YOUR ROUTINE, YOUR RULES <span aria-hidden=\"true\">✳</span> KYNZA</p></div><div class=\"kynza-hero__visual\"><div class=\"kynza-hero__image-stack\">{% assign hero_product = all_products['rejuvenating-variety-pack-4-1'] %}{% if hero_product == blank %}{% assign hero_product = collections.all.products.first %}{% endif %}{% if hero_product and hero_product.featured_image %}<a href=\"{{ hero_product.url }}\" class=\"kynza-hero__product\"><span class=\"kynza-hero__badge\">THE STARTER RITUAL / 01</span><img src=\"{{ hero_product.featured_image | image_url: width: 1100 }}\" srcset=\"{{ hero_product.featured_image | image_url: width: 550 }} 550w, {{ hero_product.featured_image | image_url: width: 850 }} 850w, {{ hero_product.featured_image | image_url: width: 1100 }} 1100w\" sizes=\"(max-width: 900px) 90vw, 42vw\" alt=\"{{ hero_product.featured_image.alt | default: hero_product.title | escape }}\" width=\"1100\" height=\"1375\" fetchpriority=\"high\"><span class=\"kynza-hero__caption\">{{ hero_product.title | escape }} <span aria-hidden=\"true\">↗</span></span></a>{% else %}<div class=\"kynza-hero__placeholder\"><span>✳</span><strong>YOUR GLOW<br>STARTS HERE.</strong><small>MEET YOUR NEW FAVORITE RITUAL</small></div>{% endif %}<span class=\"kynza-hero__stamp\" aria-hidden=\"true\">A LITTLE<br>SELF-CARE<br>GOES A LONG WAY</span></div></div></section>",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "kynza_intro": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"kynza-intro\" id=\"kynza-discover\"><div><p class=\"kynza-eyebrow\">01 / SKINCARE THAT FITS YOUR LIFE</p><h2>Good skin days.<br><em>Your way.</em></h2></div><div class=\"kynza-intro__copy\"><p>KYNZA makes discovering skincare feel simple. Start with a sheet mask, find the formulas that fit your skin mood, and build a routine you actually look forward to.</p><a class=\"kynza-link\" href=\"{{ routes.all_products_collection_url }}\">Explore the KYNZA edit ↗</a></div></section>",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "kynza_categories": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"kynza-categories kynza-rituals\"><div class=\"kynza-section-head\"><p class=\"kynza-eyebrow\">02 / SHOP BY SKIN MOOD</p><h2>What does your skin<br><em>feel like today?</em></h2><p class=\"kynza-section-subtitle\">Four feel-good ways to find your next favorite.</p></div><div class=\"kynza-ritual-grid\">{% assign p_hydrate = all_products['daily-milk-mask-hydrating-sheet-mask'] %}{% assign p_glow = all_products['daily-vitamin-c-facial-skin-mask'] %}{% assign p_firm = all_products['daily-collagen-firming-facial-skin-mask'] %}{% assign p_reset = all_products['daily-seaweed-facial-skin-mask'] %}<a class=\"kynza-ritual-card\" href=\"{{ p_hydrate.url | default: routes.all_products_collection_url }}\"><div class=\"kynza-ritual-card__image\">{% if p_hydrate.featured_image %}<img src=\"{{ p_hydrate.featured_image | image_url: width: 700 }}\" alt=\"{{ p_hydrate.title | escape }}\" loading=\"lazy\" width=\"700\" height=\"850\">{% endif %}<span>01 / THE HYDRATION EDIT</span></div><div class=\"kynza-ritual-card__foot\"><div><h3>Need a drink?</h3><p>Meet your hydration moment.</p></div><span aria-hidden=\"true\">↗</span></div></a><a class=\"kynza-ritual-card\" href=\"{{ p_glow.url | default: routes.all_products_collection_url }}\"><div class=\"kynza-ritual-card__image\">{% if p_glow.featured_image %}<img src=\"{{ p_glow.featured_image | image_url: width: 700 }}\" alt=\"{{ p_glow.title | escape }}\" loading=\"lazy\" width=\"700\" height=\"850\">{% endif %}<span>02 / THE BRIGHT SIDE</span></div><div class=\"kynza-ritual-card__foot\"><div><h3>Chasing glow?</h3><p>Find your bright-side favorite.</p></div><span aria-hidden=\"true\">↗</span></div></a><a class=\"kynza-ritual-card\" href=\"{{ p_firm.url | default: routes.all_products_collection_url }}\"><div class=\"kynza-ritual-card__image\">{% if p_firm.featured_image %}<img src=\"{{ p_firm.featured_image | image_url: width: 700 }}\" alt=\"{{ p_firm.title | escape }}\" loading=\"lazy\" width=\"700\" height=\"850\"><span>03 / THE FIRMING EDIT</span>{% endif %}</div><div class=\"kynza-ritual-card__foot\"><div><h3>Time to treat?</h3><p>A little extra care, please.</p></div><span aria-hidden=\"true\">↗</span></div></a><a class=\"kynza-ritual-card\" href=\"{{ p_reset.url | default: routes.all_products_collection_url }}\"><div class=\"kynza-ritual-card__image\">{% if p_reset.featured_image %}<img src=\"{{ p_reset.featured_image | image_url: width: 700 }}\" alt=\"{{ p_reset.title | escape }}\" loading=\"lazy\" width=\"700\" height=\"850\"><span>04 / THE RESET</span>{% endif %}</div><div class=\"kynza-ritual-card__foot\"><div><h3>Ready to reset?</h3><p>Press pause and refresh.</p></div><span aria-hidden=\"true\">↗</span></div></a></div></section>",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "kynza_products": {
      "type": "product-list",
      "settings": {
        "collection": "all",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 8,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 20,
        "rows_gap": 42,
        "icons_style": "none",
        "icons_shape": "none",
        "section_width": "page-width",
        "horizontal_alignment": "flex-start",
        "gap": 32,
        "background_color": "",
        "padding-block-start": 0,
        "padding-block-end": 0
      },
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": true,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "gap": 12,
            "width": "fill",
            "height": "fit"
          },
          "blocks": {
            "title": {
              "type": "_product-list-text",
              "settings": {
                "text": "<p>03 / THE KYNZA SKIN EDIT</p><h2>Find your next<br><em>feel-good favorite.</em></h2><p>Easy-to-love skincare, picked for your everyday routine.</p>",
                "width": "fit-content",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "wrap": "pretty"
              }
            },
            "shop-all": {
              "type": "_product-list-button",
              "settings": {
                "label": "View all →",
                "open_in_new_tab": false,
                "style_class": "link",
                "width": "fit-content",
                "width_mobile": "fit-content"
              }
            }
          },
          "block_order": [
            "title",
            "shop-all"
          ]
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 8,
            "border": "none",
            "border_width": 0,
            "border_opacity": 0,
            "border_radius": 0
          },
          "blocks": {
            "gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "adapt",
                "border": "none",
                "border_width": 0,
                "border_opacity": 0,
                "border_radius": 0
              }
            },
            "title": {
              "type": "product-title",
              "settings": {
                "width": "100%",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "1.4",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "padding-block-start": 10
              }
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "paragraph",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "0.95rem",
                "line_height": "1.4",
                "letter_spacing": "normal",
                "case": "none"
              }
            }
          },
          "block_order": [
            "gallery",
            "title",
            "price"
          ]
        }
      }
    },
    "kynza_close": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"kynza-close kynza-close--beauty\"><div><p class=\"kynza-eyebrow\">05 / MAKE A MOMENT FOR YOU</p><h2>Good skin days<br><em>look good on you.</em></h2><p>Start with one mask. Find the essentials you love. Make your routine a little more you.</p></div><a class=\"kynza-button kynza-button--light\" href=\"{{ routes.all_products_collection_url }}\">Find your feel-good favorite ↗</a></section>",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "kynza_routine": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% assign p_moisturizer = all_products['biome-boost-cream-daily-moisturizer'] %}{% assign p_spf = all_products['luxury-hybrid-daily-sunscreen-spf-50-with-ginseng-extract'] %}{% assign p_overnight = all_products['deep-collagen-glass-skin-overnight-mask-4-pack'] %}<section class=\"kynza-routine\" aria-labelledby=\"kynza-routine-title\"><div class=\"kynza-routine__head\"><div><p class=\"kynza-eyebrow\">04 / BUILD YOUR EVERYDAY RITUAL</p><h2 id=\"kynza-routine-title\">A little more than<br><em>a sheet mask.</em></h2><p>Meet the everyday essentials that round out your skincare shelf.</p></div><a class=\"kynza-link\" href=\"{{ routes.all_products_collection_url }}\">Shop all skincare ↗</a></div><div class=\"kynza-routine__grid\">{% if p_moisturizer != blank %}<a class=\"kynza-routine__card\" href=\"{{ p_moisturizer.url }}\"><div class=\"kynza-routine__image\"><img src=\"{{ p_moisturizer.featured_image | image_url: width: 900 }}\" alt=\"{{ p_moisturizer.featured_image.alt | default: p_moisturizer.title | escape }}\" loading=\"lazy\" width=\"900\" height=\"900\"></div><div class=\"kynza-routine__meta\"><span>DAILY ESSENTIAL / 01</span><h3>{{ p_moisturizer.title | escape }}</h3><p>Daily moisture + barrier support.</p><strong>Shop moisturizer ↗</strong></div></a>{% endif %}{% if p_spf != blank %}<a class=\"kynza-routine__card\" href=\"{{ p_spf.url }}\"><div class=\"kynza-routine__image\"><img src=\"{{ p_spf.featured_image | image_url: width: 900 }}\" alt=\"{{ p_spf.featured_image.alt | default: p_spf.title | escape }}\" loading=\"lazy\" width=\"900\" height=\"900\"></div><div class=\"kynza-routine__meta\"><span>DAILY ESSENTIAL / 02</span><h3>{{ p_spf.title | escape }}</h3><p>SPF 50 for your everyday routine.</p><strong>Shop sun care ↗</strong></div></a>{% endif %}{% if p_overnight != blank %}<a class=\"kynza-routine__card\" href=\"{{ p_overnight.url }}\"><div class=\"kynza-routine__image\"><img src=\"{{ p_overnight.featured_image | image_url: width: 900 }}\" alt=\"{{ p_overnight.featured_image.alt | default: p_overnight.title | escape }}\" loading=\"lazy\" width=\"900\" height=\"900\"></div><div class=\"kynza-routine__meta\"><span>YOUR NIGHT IN / 03</span><h3>{{ p_overnight.title | escape }}</h3><p>A collagen hydrogel mask for overnight care.</p><strong>Shop overnight care ↗</strong></div></a>{% endif %}</div></section>",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
  "order": [
    "kynza_hero",
    "kynza_intro",
    "kynza_categories",
    "kynza_products",
    "kynza_routine",
    "kynza_close"
  ]
}